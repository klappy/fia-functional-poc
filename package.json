{
  "name": "fia-functional-poc",
  "version": "0.1.17",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-offline-shell.mjs && node scripts/verify-release.mjs && node scripts/verify-release-stamp.mjs",
    "preview": "vite preview",
    "prepare:content": "node scripts/prepare-content.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:audio": "node scripts/verify-audio.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "test:pwa": "playwright test -c playwright.pwa.config.js"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "wrangler": "4.131.0"
  }
}
